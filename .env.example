# ─── Frontend (Next.js public, exposed to browser) ──────────────────────────
# Get one for free at https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Filled in by `npm run contracts:deploy:sepolia`
NEXT_PUBLIC_AGENT_REGISTRY=
NEXT_PUBLIC_DUEL_FACTORY=
NEXT_PUBLIC_DUEL_MARKET=
NEXT_PUBLIC_USDC=
NEXT_PUBLIC_USDY=
NEXT_PUBLIC_METH=
NEXT_PUBLIC_USDY_VENUE=
NEXT_PUBLIC_METH_VENUE=

# ─── Agent runtime (server-side only) ───────────────────────────────────────
# https://aistudio.google.com/apikey  - free tier is generous
GOOGLE_GENERATIVE_AI_API_KEY=

# Deployer for Hardhat. Get testnet MNT from https://faucet.sepolia.mantle.xyz/
DEPLOYER_PRIVATE_KEY=

# Optional: contract verification on Mantlescan
MANTLESCAN_API_KEY=

# ─── Bybit testnet (optional) ───────────────────────────────────────────────
# Free keys at https://testnet.bybit.com/app/user/api-management
# Without these, agent + human positions are shown with deterministic mock data.
BYBIT_API_KEY=
BYBIT_API_SECRET=
